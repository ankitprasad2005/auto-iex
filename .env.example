POSTGRES_USER=autoiex
POSTGRES_PASSWORD=changeme
POSTGRES_DB=autoiex
DATABASE_URL=postgresql+psycopg2://autoiex:changeme@db:5432/autoiex
DAM_SCRAPE_HOUR=13

# Not used by docker-compose (the frontend reaches the backend through its
# own nginx reverse proxy at /api/, wired via BACKEND_URL in
# docker-compose.yml — see frontend/nginx.conf.template). Only needed for
# local frontend dev without Docker, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000 npm run dev

# Testnet anchoring: publishes the three chain heads to Polygon Amoy.
# Leave ANCHOR_PRIVATE_KEY blank to disable. If you enable it, generate a
# throwaway testnet-only wallet and fund it from an Amoy faucet — never use
# a key that holds real funds.
ANCHOR_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
ANCHOR_CHAIN_ID=80002
ANCHOR_PRIVATE_KEY=
ANCHOR_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/
